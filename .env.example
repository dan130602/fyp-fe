# AWS region the Cognito user pool lives in. AWS Console: Cognito > User pools >
# (select pool) > top-right region selector, or the "ARN" field shows it.
VITE_COGNITO_REGION=ap-southeast-1

# The Cognito user pool ID. AWS Console: Cognito > User pools > (select pool) >
# "User pool overview" panel, field "User pool ID".
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx

# App client ID for the secretless SPA client (NOT the client with a secret).
# AWS Console: Cognito > User pools > (select pool) > App integration tab >
# "App clients and analytics" list > select the browser/SPA client > "Client ID".
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the media-processing-service backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8080
